RhoxDefSlavesEconomy
{
  ListBox
  {
    Component("57D7D9C8-A8AD-5728-9D57907F44F69288")
  }

  PanelParent (CcoCampaignProvince c)
  {
    Component("CcoCampaignProvince" + ContextObjectId(c), "rhox_def_slaves_list_provinces")
  }

  WantedSlaves (CcoCampaignProvince c) { Floor(ToNumber(RhoxDefSlavesEconomy.PanelParent(c).GetProperty("labour_diff"))) }

  PoolTotal
  {
    Floor(PlayersFaction.PooledResourceContext("def_slaves").Total)
  }

  PendingTotal
  {
    Floor(RhoxDefSlavesEconomy.ListBox.ChildList.Sum((c) => ToNumber(c.GetProperty("labour_diff"))))
  }

  Available
  {
    RhoxDefSlavesEconomy.PoolTotal - RhoxDefSlavesEconomy.PendingTotal
  }

  AnyChangeWanted
  {
    RhoxDefSlavesEconomy.ListBox.ChildList.Any((c) => ToNumber(c.GetProperty("labour_diff")) != 0)
  }

  SlaveChangeWanted (CcoCampaignProvince c) { RhoxDefSlavesEconomy.WantedSlaves(c) != 0 }

  AnyMeaningfulChangeWanted
  {
    RhoxDefSlavesEconomy.ListBox.ChildList.Any((c) => c.IsVisible && RhoxDefSlavesEconomy.SlaveChangeWanted(c.StoredContextRequired("CcoCampaignProvince")))
  }

  CanAccept
  {
    RhoxDefSlavesEconomy.AnyChangeWanted && RhoxDefSlavesEconomy.Available >= 0
  }

  IncreaseSlaves (Int amount, CcoCampaignProvince c)
  {
    (available       = MaxNumericValue(RhoxDefSlavesEconomy.Available, 0),
     capped          = GetIfElse(amount > 0, MinNumericValue(amount, available), amount),
     after_mod_value = Floor(ToNumber(Component("amount").CurrentText)) + capped,
     value           = GetIfElse(after_mod_value < 0, 0, after_mod_value)) => {

      Do(Component("amount").SetText(value), UiMsg("RhoxDefSlavesChanged"))
    }
  }

  ProcessChanges
  {
    Do(
      RhoxDefSlavesEconomy.ListBox.ChildList.Filter(IsVisible).ForEach(
        (c, a = Floor(ToNumber(c.GetProperty("labour_diff")))) =>
          DoIf(a < 0, TriggerScriptEvent(Format("rhox_def_slaves_move:%S:%d", c.StoredContextRequired("CcoCampaignProvince").Key, a)))
      ),
      RhoxDefSlavesEconomy.ListBox.ChildList.Filter(IsVisible).ForEach(
        (c, a = Floor(ToNumber(c.GetProperty("labour_diff")))) =>
          DoIf(a > 0, TriggerScriptEvent(Format("rhox_def_slaves_move:%S:%d", c.StoredContextRequired("CcoCampaignProvince").Key, a)))
      ),
      UiMsg("RhoxDefSlavesClearAll")
    )
  }

  SlaveChangeMajor { 10 }

  GoldPerSlave { 1 }
}

CcoCampaignProvince
{
  RhoxExSlaves    { LocalPlayerProvinceManagerContext.PooledResourceContext("rhox_def_slaves_province") }
  RhoxExSlaveNeed { LocalPlayerProvinceManagerContext.PooledResourceContext("rhox_def_slaves_province_need") }
  RhoxExSlaveInefficiency { LocalPlayerProvinceManagerContext.PooledResourceContext("rhox_def_slaves_province_inefficiency") }

  RhoxTempEfficiency
  {
    RhoxExSlaveNeed.Total > 0 | Abs(RhoxExSlaves.Total + RhoxDefSlavesEconomy.WantedSlaves(this)) / Abs(RhoxExSlaveNeed.Total) | 0
  }

  RhoxGoldModifier
  {
    (eff = GetIfElse(RhoxDefSlavesEconomy.SlaveChangeWanted(this), MinNumericValue(RoundFloat(RhoxTempEfficiency * 100), 100), 100 - RhoxExSlaveInefficiency.Total)) => {
      eff - 50
    }
  }

  RhoxGoldModifierText
  {
    (m = RhoxGoldModifier, prefix = GetIfElse(RhoxDefSlavesEconomy.SlaveChangeWanted(this), "~", "")) => {
      GetIfElse(RhoxExSlaveNeed.Total > 0, prefix + GetIfElse(m > 0, Format("+%d%%", m), Format("%d%%", m)), "-")
    }
  }

  RhoxExSlaveFlatIncome
  {
    RoundFloat(RhoxExSlaves.Total * RhoxDefSlavesEconomy.GoldPerSlave)
  }

  RhoxExGoldOutput
  {
    RoundFloat(LocalPlayerProvinceManagerContext.GrossIncome)
  }
}
