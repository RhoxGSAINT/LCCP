RhoxKeyKeeperSlaveEconomy
{
  ListBox
  {
    Component("8EBCC7E6-7114-56B9-B719C249A231F294")
  }

  PanelParent (CcoCampaignProvince c)
  {
    Component("CcoCampaignProvince" + ContextObjectId(c), "rhox_key_keeper_list_provinces")
  }

  WantedSlaves (CcoCampaignProvince c) { Floor(ToNumber(RhoxKeyKeeperSlaveEconomy.PanelParent(c).GetProperty("labour_diff"))) }

  PoolTotal
  {
    Floor(PlayersFaction.PooledResourceContext("def_slaves").Total)
  }

  PendingTotal
  {
    Floor(RhoxKeyKeeperSlaveEconomy.ListBox.ChildList.Sum((c) => ToNumber(c.GetProperty("labour_diff"))))
  }

  Available
  {
    RhoxKeyKeeperSlaveEconomy.PoolTotal - RhoxKeyKeeperSlaveEconomy.PendingTotal
  }

  AnyChangeWanted
  {
    RhoxKeyKeeperSlaveEconomy.ListBox.ChildList.Any((c) => ToNumber(c.GetProperty("labour_diff")) != 0)
  }

  SlaveChangeWanted (CcoCampaignProvince c) { RhoxKeyKeeperSlaveEconomy.WantedSlaves(c) != 0 }

  AnyMeaningfulChangeWanted
  {
    RhoxKeyKeeperSlaveEconomy.ListBox.ChildList.Any((c) => c.IsVisible && RhoxKeyKeeperSlaveEconomy.SlaveChangeWanted(c.StoredContextRequired("CcoCampaignProvince")))
  }

  CanAccept
  {
    RhoxKeyKeeperSlaveEconomy.AnyChangeWanted && RhoxKeyKeeperSlaveEconomy.Available >= 0
  }

  IncreaseSlaves (Int amount, CcoCampaignProvince c)
  {
    (available       = MaxNumericValue(RhoxKeyKeeperSlaveEconomy.Available, 0),
     capped          = GetIfElse(amount > 0, MinNumericValue(amount, available), amount),
     after_mod_value = Floor(ToNumber(Component("amount").CurrentText)) + capped,
     value           = GetIfElse(after_mod_value < 0, 0, after_mod_value)) => {

      Do(Component("amount").SetText(value), UiMsg("RhoxKeyKeeperSlavesChanged"))
    }
  }

  ProcessChanges
  {
    Do(
      RhoxKeyKeeperSlaveEconomy.ListBox.ChildList.Filter(IsVisible).ForEach(
        (c, a = Floor(ToNumber(c.GetProperty("labour_diff")))) =>
          DoIf(a < 0, TriggerScriptEvent(Format("rhox_key_keeper_slaves_move:%S:%d", c.StoredContextRequired("CcoCampaignProvince").Key, a)))
      ),
      RhoxKeyKeeperSlaveEconomy.ListBox.ChildList.Filter(IsVisible).ForEach(
        (c, a = Floor(ToNumber(c.GetProperty("labour_diff")))) =>
          DoIf(a > 0, TriggerScriptEvent(Format("rhox_key_keeper_slaves_move:%S:%d", c.StoredContextRequired("CcoCampaignProvince").Key, a)))
      ),
      UiMsg("RhoxKeyKeeperSlavesClearAll")
    )
  }

  SlaveChangeMajor { 10 }

  GoldPerSlave { 1 }
}

CcoCampaignProvince
{
  RhoxExSlaves    { LocalPlayerProvinceManagerContext.PooledResourceContext("rhox_key_keeper_province") }
  RhoxExSlaveNeed { LocalPlayerProvinceManagerContext.PooledResourceContext("rhox_key_keeper_province_need") }
  RhoxExSlaveInefficiency { LocalPlayerProvinceManagerContext.PooledResourceContext("rhox_key_keeper_province_inefficiency") }

  RhoxTempEfficiency
  {
    RhoxExSlaveNeed.Total > 0 | Abs(RhoxExSlaves.Total + RhoxKeyKeeperSlaveEconomy.WantedSlaves(this)) / Abs(RhoxExSlaveNeed.Total) | 0
  }

  RhoxGoldModifier
  {
    (eff = GetIfElse(RhoxKeyKeeperSlaveEconomy.SlaveChangeWanted(this), MinNumericValue(RoundFloat(RhoxTempEfficiency * 100), 100), 100 - RhoxExSlaveInefficiency.Total)) => {
      eff - 50
    }
  }

  RhoxGoldModifierText
  {
    (m = RhoxGoldModifier, prefix = GetIfElse(RhoxKeyKeeperSlaveEconomy.SlaveChangeWanted(this), "~", "")) => {
      GetIfElse(RhoxExSlaveNeed.Total > 0, prefix + GetIfElse(m > 0, Format("+%d%%", m), Format("%d%%", m)), "-")
    }
  }

  RhoxExSlaveFlatIncome
  {
    RoundFloat(RhoxExSlaves.Total * RhoxKeyKeeperSlaveEconomy.GoldPerSlave)
  }

  RhoxExGoldOutput
  {
    RoundFloat(LocalPlayerProvinceManagerContext.GrossIncome)
  }
}
